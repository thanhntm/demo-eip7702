# Environment Configuration for SafeBatchApprove Deployment

# Private key of the deployer account (without 0x prefix)
# NEVER commit this to version control!
PRIVATE_KEY=your_private_key_here

# Ethereum Mainnet RPC URL (get from Alchemy, Infura, or other provider)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY

# Sepolia Testnet RPC URL (for testing)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Gas reporting (optional)
REPORT_GAS=false
